{
  "name": "vscode-ai-commit",
  "displayName": "AI Commit++",
  "description": "%description%",
  "version": "1.0.3",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Azure",
    "OpenAI",
    "ChatGPT",
    "GitEmoji",
    "Git Commit",
    "Conventional Commits",
    "Commitizen",
    "Commit Message",
    "Commit Message Generator",
    "AI Commit",
    "Auto Commit"
  ],
  "license": "MIT",
  "publisher": "NicholasHsiang",
  "repository": "https://github.com/xianghongai/vscode-ai-commit",
  "icon": "images/logo.png",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts --minify",
    "compile": "tsup --config tsup.config.ts",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "publish": "vsce publish --no-dependencies",
    "test": "node --test ./out/test/provider-config.test.js ./out/test/provider-adapters.test.js ./out/test/repository-utils.test.js",
    "vscode:prepublish": "pnpm run build",
    "watch": "tsup --config tsup.config.ts --watch",
    "watch-tests": "tsc -p . -w --outDir out"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.37.0",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "fs-extra": "^11.0.4",
    "openai": "^4.14.2",
    "simple-git": "^3.17.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.ai-commit",
        "icon": {
          "dark": "images/icon.svg",
          "light": "images/icon-gray.svg"
        },
        "title": "%command.aiCommit%"
      },
      {
        "command": "ai-commit.switchProvider",
        "title": "%command.switchProvider%"
      }
    ],
    "configuration": {
      "properties": {
        "ai-commit.commitLanguage": {
          "default": "English",
          "description": "%config.language.description%",
          "markdownDescription": "%config.language.markdown%",
          "enum": [
            "Simplified Chinese",
            "Traditional Chinese",
            "Japanese",
            "Korean",
            "Czech",
            "German",
            "French",
            "Italian",
            "Dutch",
            "Portuguese",
            "Vietnamese",
            "English",
            "Spanish",
            "Swedish",
            "Russian",
            "Bahasa",
            "Polish",
            "Turkish",
            "Thai"
          ],
          "enumDescriptions": [
            "简体中文",
            "繁體中文",
            "にほんご",
            "한국어",
            "česky",
            "Deutsch",
            "française",
            "italiano",
            "Nederlands",
            "português",
            "tiếng Việt",
            "english",
            "español",
            "Svenska",
            "русский",
            "bahasa",
            "Polski",
            "Turkish",
            "ไทย"
          ],
          "type": "string"
        },
        "ai-commit.providers": {
          "type": "array",
          "description": "%config.providers.description%",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "openai",
                  "openai-compatible",
                  "openrouter",
                  "gemini",
                  "azure-openai",
                  "ollama"
                ]
              },
              "model": {
                "type": "string"
              },
              "modelKind": {
                "type": "string",
                "enum": [
                  "chat"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "deployment": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "apiVersion": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "number",
                "minimum": 1,
                "default": 120000
              },
              "params": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "maxTokens": {
                    "type": "number",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "model"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "openai-compatible",
                        "openrouter"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "baseUrl"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "azure-openai"
                    }
                  }
                },
                "then": {
                  "required": [
                    "endpoint",
                    "apiVersion",
                    "deployment"
                  ]
                }
              }
            ]
          }
        },
        "ai-commit.activeProviderId": {
          "type": "string",
          "default": "",
          "description": "%config.activeProviderId.description%"
        },
        "ai-commit.promptFlavor": {
          "type": "string",
          "default": "Conventional Commits",
          "enum": [
            "Conventional Commits",
            "Conventional Commits with Gitmoji"
          ],
          "enumDescriptions": [
            "%config.promptFlavor.conventional%",
            "%config.promptFlavor.conventionalWithGitmoji%"
          ],
          "description": "%config.promptFlavor.description%",
          "markdownDescription": "%config.promptFlavor.markdown%"
        },
        "ai-commit.promptFile": {
          "type": "string",
          "default": "",
          "description": "%config.promptFile.description%",
          "markdownDescription": "%config.promptFile.markdown%"
        }
      },
      "title": "%config.title%"
    },
    "menus": {
      "scm/title": [
        {
          "command": "extension.ai-commit",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ai-commit.switchProvider",
          "when": "true"
        }
      ]
    }
  }
}