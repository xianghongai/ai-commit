{
  "name": "vscode-ai-commit",
  "displayName": "AI Commit++",
  "version": "1.1.0",
  "description": "%description%",
  "categories": [
    "Other"
  ],
  "keywords": [
    "AI Commit",
    "Auto Commit",
    "Azure",
    "ChatGPT",
    "Commit Message",
    "Commit Message Generator",
    "Commitizen",
    "Conventional Commits",
    "Git Commit",
    "GitEmoji",
    "OpenAI"
  ],
  "license": "MIT",
  "repository": "https://github.com/xianghongai/vscode-ai-commit",
  "publisher": "NicholasHsiang",
  "main": "./dist/extension.js",
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf --glob \"*.vsix\" dist",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src test",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "test": "vitest run",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "pnpm run clean && pnpm run package",
    "watch": "pnpm run \"/^watch:/\"",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "openai": "^4.14.2",
    "simple-git": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "lint-staged": "^17.4.1",
    "ovsx": "^1.1.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ],
    "!(pnpm-lock).{yml,yaml}": [
      "oxfmt"
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.ai-commit",
        "icon": {
          "dark": "images/icon.svg",
          "light": "images/icon-gray.svg"
        },
        "title": "%command.aiCommit%"
      },
      {
        "command": "ai-commit.switchProvider",
        "title": "%command.switchProvider%"
      }
    ],
    "configuration": {
      "properties": {
        "ai-commit.commitLanguage": {
          "default": "English",
          "description": "%config.language.description%",
          "markdownDescription": "%config.language.markdown%",
          "enum": [
            "Simplified Chinese",
            "Traditional Chinese",
            "Japanese",
            "Korean",
            "Czech",
            "German",
            "French",
            "Italian",
            "Dutch",
            "Portuguese",
            "Vietnamese",
            "English",
            "Spanish",
            "Swedish",
            "Russian",
            "Bahasa",
            "Polish",
            "Turkish",
            "Thai"
          ],
          "enumDescriptions": [
            "简体中文",
            "繁體中文",
            "にほんご",
            "한국어",
            "česky",
            "Deutsch",
            "française",
            "italiano",
            "Nederlands",
            "português",
            "tiếng Việt",
            "english",
            "español",
            "Svenska",
            "русский",
            "bahasa",
            "Polski",
            "Turkish",
            "ไทย"
          ],
          "type": "string"
        },
        "ai-commit.providers": {
          "type": "array",
          "description": "%config.providers.description%",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "openai",
                  "openai-compatible",
                  "openrouter",
                  "gemini",
                  "azure-openai",
                  "ollama"
                ]
              },
              "model": {
                "type": "string"
              },
              "modelKind": {
                "type": "string",
                "enum": [
                  "chat"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "deployment": {
                "type": "string"
              },
              "apiKey": {
                "type": "string",
                "minLength": 1,
                "markdownDescription": "%config.providers.apiKey.markdown%"
              },
              "apiVersion": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "number",
                "minimum": 1,
                "default": 120000
              },
              "params": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "maxTokens": {
                    "type": "number",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "model"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "openai-compatible",
                        "openrouter"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "baseUrl"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "azure-openai"
                    }
                  }
                },
                "then": {
                  "required": [
                    "endpoint",
                    "apiVersion",
                    "deployment"
                  ]
                }
              }
            ]
          }
        },
        "ai-commit.activeProviderId": {
          "type": "string",
          "default": "",
          "description": "%config.activeProviderId.description%"
        },
        "ai-commit.promptFlavor": {
          "type": "string",
          "default": "Conventional Commits",
          "enum": [
            "Conventional Commits",
            "Conventional Commits with Gitmoji"
          ],
          "enumDescriptions": [
            "%config.promptFlavor.conventional%",
            "%config.promptFlavor.conventionalWithGitmoji%"
          ],
          "description": "%config.promptFlavor.description%",
          "markdownDescription": "%config.promptFlavor.markdown%"
        },
        "ai-commit.promptFile": {
          "type": "string",
          "default": "",
          "description": "%config.promptFile.description%",
          "markdownDescription": "%config.promptFile.markdown%"
        }
      },
      "title": "%config.title%"
    },
    "menus": {
      "scm/title": [
        {
          "command": "extension.ai-commit",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ai-commit.switchProvider",
          "when": "true"
        }
      ]
    }
  },
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.25.0"
}
